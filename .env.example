# ZK Posture Gate - environment variables
# Copy this file to .env and fill in your own values.
# .env is git-ignored. NEVER commit real secrets.
#
# This project does not load .env automatically (no dotenv dependency, by design).
# Set these in PowerShell for the session, for example:
#   $env:ADMIN_PASSWORD = "choose-a-long-password"
#   $env:DEMO_LAN = "1"
# or use the helper script: scripts\start-verifier.ps1

# ---------------------------------------------------------------------------
# VERIFIER SERVICE
# ---------------------------------------------------------------------------

# Password for the admin dashboard. Required: the verifier refuses to start
# without it. Minimum 12 characters. Placeholder only.
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign short-lived gate tokens and admin session cookies.
# Generated automatically on first run into verifier/data/token-signing.key
# (git-ignored, mode 600) if this variable is absent. Set it explicitly only
# if you need the same key across machines/restarts; never commit it.
# Leave empty to let the verifier generate one.
TOKEN_SIGNING_KEY=

# How long a one-time enrollment code stays valid, in seconds. Default 600.
ENROLL_CODE_TTL=600

# Port for the verifier + dashboard. Default 3000.
PORT=3000

# "1" binds the verifier to 0.0.0.0 (needed for the 3-laptop LAN demo).
# Anything else binds to 127.0.0.1 only. Default: 127.0.0.1.
DEMO_LAN=0

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

# TLS is ON by default with a local CA generated into verifier/data/tls.
# DEMO_INSECURE=1 is the only way to run plain HTTP, and the agent must set it
# too. Never use it outside a throwaway demo.
DEMO_INSECURE=0

# Optional: use an existing certificate instead of the generated local CA.
# Set both or neither. The cert file must include the issuing CA as a second
# PEM block so the agent can verify the chain and match its CA pin.
TLS_CERT_PATH=
TLS_KEY_PATH=

# How long a gate token (and the browser cookie) stays valid, in seconds.
# Default 600 = 10 minutes, so access does not lapse between 5-minute agent
# check-ins. A device that becomes non-compliant keeps access until its token
# expires; lower this if that window is too long for you.
GATE_TOKEN_TTL_SECONDS=600

# Admin dashboard session lifetime, in seconds. Default 28800 (8 hours).
SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------------------
# REVERSE PROXY GATE
# ---------------------------------------------------------------------------

# The real app the gate forwards to. Read at startup only; nothing in a request
# can change it. http:// or https://, no credentials, no query string.
# A path prefix is allowed: http://127.0.0.1:8080/admin
GATE_UPSTREAM=http://127.0.0.1:8080

# Port the gate listens on. Default 8081.
GATE_PORT=8081

# Optional public gate origin used in printed links. Leave empty to derive it
# from VERIFIER_URL and GATE_PORT (or the LAN IP when DEMO_LAN=1).
# Example: https://gate.corp.example
GATE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# AGENT (runs on each laptop)
# ---------------------------------------------------------------------------

# Base URL of the verifier. Used by the agent when agent/agent.config.json
# does not provide one. On the demo LAN this is https://<MAIN-PC-LAN-IP>:3000
VERIFIER_URL=https://127.0.0.1:3000

# One-time pin of the verifier CA's public key (SPKI SHA-256). The verifier
# prints it at startup and `npm run tls:info` prints it again. Colons and spaces
# are accepted. Leaf renewals and IP changes keep the same CA pin.
# The agent refuses TLS if this is empty; DEMO_INSECURE=1 is the only bypass.
ZKPG_CA_FINGERPRINT=

# Optional full gate origin, if the gate is not on the verifier host.
# Leave empty to use VERIFIER_URL's host and the GATE_PORT the verifier reports.
# Example: https://gate.corp.example
GATE_URL=

# Port for the agent's local-only UI. Always bound to 127.0.0.1. Default 4000.
AGENT_UI_PORT=4000

# Optional: where the agent keeps its device key and state.
# Default: agent/data
# Point this at another folder to enroll a SECOND identity on the same laptop
# (single-laptop demo, labelled "same machine, 2nd identity").
AGENT_DATA_DIR=
